# Copy this file to .env (it is git-ignored) and fill in the values.

# Database
DB_NAME=luckystars
DB_USERNAME=luckystars
DB_PASSWORD=change-me

# Signs the login tokens. Use a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=change-me

# Password reset emails (Brevo). Without them the reset code is created but no email is sent.
BREVO_API_KEY=
BREVO_SENDER=

# "info" in production. "debug" also logs database queries, including bound values.
LOG_LEVEL=info

# Set to true ONLY behind a reverse proxy that sets X-Forwarded-For itself (used for rate limits).
TRUST_PROXY=false
